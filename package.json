  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:no-console-server": "! grep -RIEn --include='*.ts' --include='*.tsx' 'console\\.(log|warn|error|info|debug)' app/api lib/agents lib/jobs lib/integrations lib/anthropic.ts lib/rate-limit.ts",
    "check:prod-env": "node scripts/check-prod-env.mjs",
    "verify": "npm run build && npm run check:no-console-server",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "load:widget": "node scripts/load-widget.mjs",
    "launch:verify": "npm run verify && npm run smoke:prod",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",

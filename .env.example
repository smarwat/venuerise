# =============================================================================
# VenueRise — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase — service role. SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# Found in: Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic API. SERVER-ONLY.
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Base URL of this app. Used by /api/widget to call /api/ai/qualify internally.
# In production this should be the canonical https URL (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Internal HMAC secret — signs service-to-service calls inside VenueRise
# (e.g. the public widget triggering /api/ai/qualify). SERVER-ONLY.
#
# Generate a strong value: `openssl rand -hex 32`
# Must be at least 32 characters.
#
# Rotation: changing this value will break any in-flight signed requests for
# a few seconds (the widget retries are dropped). For zero-downtime rotation
# you'd need a multi-key verifier — not implemented yet.
# =============================================================================
INTERNAL_API_SECRET=replace-me-with-openssl-rand-hex-32
